{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Check Prerequisites",
      "type": "shell",
      "command": "bash scripts/check-prerequisites.sh",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    },
    {
      "label": "Backend: Start Postgres",
      "type": "shell",
      "command": "docker compose up -d && docker compose ps",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Backend: Install Dependencies",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Backend: Migrate Database",
      "type": "shell",
      "command": "npm run db:migrate",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Backend: Full Setup",
      "dependsOn": [
        "Backend: Run Setup Script"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Backend: Run Setup Script",
      "type": "shell",
      "command": "bash scripts/setup.sh",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    },
    {
      "label": "Backend: Start API",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "listening on http://localhost:(\\d+)",
          "line": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "listening on http://localhost:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Backend: Test /analyze",
      "type": "shell",
      "command": "curl -s -X POST http://localhost:3001/analyze -H 'Content-Type: application/json' -d '{\"handle\":\"@ashiqshorts\"}' | python3 -m json.tool",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    },
    {
      "label": "Backend: Stop Postgres",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
